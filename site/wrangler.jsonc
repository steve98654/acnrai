// Cloudflare Workers config. Serves the built site from dist/ and runs the
// password gate (worker/index.js) in front of every request.
// If your Worker in the Cloudflare dashboard has a different name, change
// "name" to match it, or Workers Builds will refuse the deploy.
// Cloudflare Pages ignores this file (no pages_build_output_dir) and uses
// functions/_middleware.js instead.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acnrai",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
