---
import Base from '../layouts/Base.astro';
import Chevron from '../components/Chevron.astro';
import { offerings, useCases } from '../data/usecases';
const label = Object.fromEntries(offerings.map((o) => [o.key, o]));
---
<Base
  title="Use cases | Accenture and Faculty Responsible AI"
  description="A gallery of illustrative use cases for current state assessment, governance and red teaming."
>
  <section class="top grid-bg" aria-labelledby="uc-title">
    <Chevron class="top__chev" />
    <div class="wrap top__in">
      <p class="kicker reveal">Use cases / Gallery</p>
      <h1 class="display h1 reveal" id="uc-title">What it looks<br />like in practice.</h1>
      <p class="lede reveal">
        Twelve examples across our three offerings. Tap a card to turn it over. These are synthetic composites that
        show the shape of the work, not real clients or results.
      </p>
    </div>
  </section>

  <section class="sec sec--light gallery" aria-label="Use case gallery">
    <div class="wrap">
      <div class="filters reveal" role="group" aria-label="Filter by offering">
        <button class="chip mono is-on" data-filter="all" aria-pressed="true">All <span>{useCases.length}</span></button>
        {offerings.map((o) => (
          <button class="chip mono" data-filter={o.key} aria-pressed="false">
            {o.n} {o.short} <span>{useCases.filter((u) => u.offering === o.key).length}</span>
          </button>
        ))}
      </div>

      {offerings.map((o) => (
        <div class="group" data-group={o.key}>
          <header class="group__head reveal">
            <p class="mono group__n">{o.n} / 03</p>
            <h2 class="display h3">{o.label}</h2>
            <p class="muted">{o.blurb}</p>
          </header>
          <ul class="cards">
            {useCases.filter((u) => u.offering === o.key).map((u, i) => (
              <li class="reveal" style={`transition-delay:${i * 70}ms`}>
                <button class={`card card--${u.offering}`} aria-pressed="false" aria-label={`${u.title}. Show details`}>
                  <span class="card__inner">
                    {/* Front */}
                    <span class="card__face card__front">
                      <span class="card__band">
                        <span class="mono card__id">No. {u.id.replace(/\D/g, '')}</span>
                        <span class="mono card__off">{label[u.offering].short}</span>
                      </span>
                      <span class="card__body">
                        <span class="mono card__ind">{u.industry}</span>
                        <span class="display card__title">{u.title}</span>
                        <span class="card__client">{u.client}</span>
                        <span class="card__models">
                          {u.models.map((m) => <span class="mono">{m}</span>)}
                          <span class="mono card__wk">{u.weeks} wk</span>
                        </span>
                      </span>
                      <span class="card__stats">
                        {u.stats.map((s) => (
                          <span class="stat"><span class="display stat__v">{s.v}</span><span class="mono stat__k">{s.k}</span></span>
                        ))}
                      </span>
                      <span class="mono card__foot">Synthetic example <span class="card__turn">Turn over <Chevron color="currentColor" /></span></span>
                    </span>
                    {/* Back */}
                    <span class="card__face card__back" aria-hidden="true">
                      <span class="mono card__backhead">No. {u.id.replace(/\D/g, '')} / {u.industry}</span>
                      <span class="card__sys">{u.system}</span>
                      <span class="card__row"><span class="mono">Challenge</span>{u.challenge}</span>
                      <span class="card__row"><span class="mono">Approach</span>{u.approach}</span>
                      <span class="card__row"><span class="mono">Outcome</span>{u.outcome}</span>
                      <span class="mono card__foot">Synthetic example <span class="card__turn">Front <Chevron color="currentColor" /></span></span>
                    </span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="note mono">All cases are synthetic and illustrative. Figures are examples of what an engagement reports, not measured results.</p>
    </div>
  </section>

  <section class="close grid-bg" aria-labelledby="uc-close">
    <div class="wrap close__in reveal">
      <h2 class="display h2" id="uc-close">Your use case, tested in two weeks.</h2>
      <div class="close__cta">
        <a class="btn btn--primary" href="/#start">Start a rapid eval <Chevron color="currentColor" /></a>
        <a class="btn" href="/#offer">See the offer</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Flip cards
  document.querySelectorAll<HTMLButtonElement>('.card').forEach((c) => {
    c.addEventListener('click', () => {
      const on = c.getAttribute('aria-pressed') !== 'true';
      c.setAttribute('aria-pressed', String(on));
      c.querySelector('.card__front')?.setAttribute('aria-hidden', String(on));
      c.querySelector('.card__back')?.setAttribute('aria-hidden', String(!on));
    });
  });
  // Filter by offering
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-pressed', String(on));
      });
      document.querySelectorAll<HTMLElement>('.group').forEach((g) => {
        g.hidden = f !== 'all' && g.dataset.group !== f;
        g.querySelectorAll('.reveal').forEach((r) => r.classList.add('in'));
      });
    }),
  );
</script>

<style>
  .top { position: relative; overflow: hidden; }
  .top__in { position: relative; display: grid; gap: 28px; padding-top: clamp(140px, 20vh, 200px); padding-bottom: clamp(64px, 9vw, 112px); }
  :global(.top__chev) { position: absolute; right: clamp(-60px, 6vw, 120px); bottom: 48px; height: clamp(220px, 40vh, 440px); width: auto; }
  @media (max-width: 900px) { :global(.top__chev) { opacity: 0.32; right: -50px; } }

  .gallery { padding-top: clamp(48px, 6vw, 72px); }
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: clamp(48px, 6vw, 72px); position: sticky; top: 72px; z-index: 5; padding: 10px 0; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(8px); }
  .chip { font: inherit; font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; height: 42px; padding: 0 16px; border: 1px solid var(--rule); background: #fff; color: var(--ink); cursor: pointer; display: inline-flex; align-items: center; gap: 10px; transition: border-color 0.2s, background 0.2s, color 0.2s; }
  .chip span { color: var(--grey); }
  .chip:hover { border-color: var(--ink); }
  .chip.is-on { background: var(--ink); color: #fff; border-color: var(--ink); }
  .chip.is-on span { color: var(--silver); }
  @media (max-width: 760px) { .filters { position: static; background: none; backdrop-filter: none; } }

  .group { margin-bottom: clamp(64px, 8vw, 104px); }
  .group[hidden] { display: none; }
  .group__head { display: grid; gap: 8px; margin-bottom: 28px; max-width: 760px; }
  .group__n { font-size: 13px; letter-spacing: 0.22em; color: var(--purple); }

  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(268px, 1fr)); gap: 20px; }

  /* ---------- baseball card ---------- */
  .card { all: unset; box-sizing: border-box; display: block; width: 100%; aspect-ratio: 5 / 7; perspective: 1400px; cursor: pointer; }
  .card:focus-visible { outline: 2px solid var(--purple); outline-offset: 4px; }
  .card__inner { position: relative; display: block; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform 0.7s var(--ease); }
  .card[aria-pressed='true'] .card__inner { transform: rotateY(180deg); }
  .card__face { position: absolute; inset: 0; display: flex; flex-direction: column; backface-visibility: hidden; -webkit-backface-visibility: hidden; overflow: hidden; border: 1px solid #27272a; }
  .card__front { background: var(--night); color: #fff; }
  .card__back { background: #fff; color: var(--ink); transform: rotateY(180deg); border-color: var(--ink); padding: 18px; gap: 10px; }
  .card:hover .card__front { border-color: var(--purple); }

  .card__band { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; background: var(--purple); color: #fff; }
  .card--govern .card__band { background: var(--deep); }
  .card--redteam .card__band { background: #fff; color: var(--ink); }
  .card__body { display: flex; flex-direction: column; gap: 10px; padding: 20px 18px 0; flex: 1; position: relative; background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px); background-size: 24px 24px; }
  .card__ind { font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--purple); }
  .card--govern .card__ind { color: #c27bff; }
  .card__title { font-size: clamp(24px, 2vw, 28px); line-height: 1.08; }
  .card__client { color: var(--silver); font-size: 15px; }
  .card__models { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-bottom: 16px; }
  .card__models span { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; border: 1px solid #3f3f46; padding: 3px 8px; background: var(--night); }
  .card__models .card__wk { border-color: var(--purple); color: #fff; }

  .card__stats { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #27272a; }
  .stat { display: grid; gap: 4px; padding: 14px 12px; border-left: 1px solid #27272a; min-width: 0; }
  .stat:first-child { border-left: 0; }
  .stat__v { font-size: 24px; line-height: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .stat__k { font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--silver); line-height: 1.3; }

  .card__foot { display: flex; justify-content: space-between; align-items: center; padding: 12px 18px; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--grey); border-top: 1px solid #27272a; }
  .card__back .card__foot { margin: auto -18px -18px; border-color: var(--rule); }
  .card__turn { display: inline-flex; align-items: center; gap: 6px; color: var(--silver); }
  .card__back .card__turn { color: var(--ink); }
  .card__turn :global(svg) { width: 5px; height: 8px; fill: var(--purple); }

  .card__backhead { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--purple); }
  .card__sys { font-family: var(--display); font-weight: 600; font-size: 17px; line-height: 1.2; padding-bottom: 10px; border-bottom: 1.5px solid var(--ink); }
  .card__row { display: grid; gap: 2px; font-size: 14px; line-height: 1.38; }
  .card__row .mono { font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--grey); }

  @media (prefers-reduced-motion: reduce) { .card__inner { transition: none; } }

  .note { font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--grey); }

  .close__in { display: grid; gap: 32px; padding-top: clamp(88px, 12vw, 160px); padding-bottom: clamp(88px, 12vw, 160px); }
  .close__cta { display: flex; flex-wrap: wrap; gap: 14px; }
</style>
