---
import Base from '../layouts/Base.astro';
import Chevron from '../components/Chevron.astro';
import Divider from '../components/Divider.astro';
import Logo from '../components/Logo.astro';
import {
  PRC, PRC_FULL, moment, partners, offer, brings, dimensions, outputs, rapidEval, loop,
  maturityLevels, heatmap, findings, findingToAction, lifecycle, operate, prc, security,
  attacks, cadence, roadmap, nextSteps,
} from '../data/site';

// Radar geometry (current state assessment, illustrative)
const R = 120, C = 160;
const angles = [90, 18, 306, 234, 162];
const pt = (a: number, r: number) => {
  const t = (a * Math.PI) / 180;
  return [C + r * Math.cos(t), C - r * Math.sin(t)].map((v) => v.toFixed(1)).join(',');
};
const ring = (f: number) => angles.map((a) => pt(a, f * R)).join(' ');
const current = angles.map((a, i) => pt(a, dimensions[i].current * R)).join(' ');
const labelPos = angles.map((a) => {
  const t = (a * Math.PI) / 180;
  return { x: C + (R + 18) * Math.cos(t), y: C - (R + 18) * Math.sin(t), anchor: Math.abs(Math.cos(t)) < 0.2 ? 'middle' : Math.cos(t) > 0 ? 'start' : 'end' };
});

// Attack diagram: five attacks around the system (deck angles)
const atkAngles = [90, 18, 306, 234, 162];
const atk = attacks.map((t, i) => {
  const a = (atkAngles[i] * Math.PI) / 180;
  return { t, x: 300 + 225 * Math.cos(a), y: 170 - 125 * Math.sin(a) };
});
const weeks = [1, 2, 3, 4];
---
<Base>
  <!-- ============ HERO ============ -->
  <section class="hero grid-bg" id="top" aria-labelledby="hero-title">
    <Chevron class="hero__chev" />
    <div class="wrap hero__in">
      <div class="hero__copy reveal">
        <p class="kicker">ACN offerings / Responsible AI and red teaming</p>
        <h1 class="display h1" id="hero-title">Responsible AI,<br />operationalised.</h1>
        <p class="lede hero__lede">
          Assess. Govern. Red team. Monitor.<br />
          One partner from first evaluation to continuous assurance.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="#start">Start a rapid eval <Chevron color="currentColor" /></a>
          <a class="btn" href="#offer">See the offer</a>
        </div>
      </div>
      <div class="hero__gao">
        <p class="hero__with mono">In partnership with Google, Anthropic and OpenAI</p>
        <ul class="hero__logos">
          {partners.map((p) => (
            <li class="hero__p"><Logo name={p.logo} size={44} /><span class="display">{p.name}</span></li>
          ))}
        </ul>
        <a class="hero__hist mono" href="/history">Our history with GAO <Chevron color="currentColor" /></a>
      </div>
    </div>
  </section>

  <!-- ============ THE MOMENT ============ -->
  <section class="sec sec--light" aria-labelledby="moment-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="kicker">The moment</p>
        <h2 class="display h2" id="moment-title">AI is scaling faster than the controls around it.</h2>
      </header>
      <div class="cols3">
        {moment.map((m, i) => (
          <article class="reveal moment" style={`transition-delay:${i * 90}ms`}>
            <p class="mono moment__n">0{i + 1}</p>
            <div class="bar"></div>
            <h3 class="display h3">{m.title}</h3>
            <p class="muted">{m.body}</p>
          </article>
        ))}
      </div>
      <p class="band reveal"><strong>The gap:</strong> most enterprises cannot say which AI they run, how it behaves under attack, or who owns the risk.</p>
    </div>
  </section>

  <!-- ============ 01 PARTNERSHIPS ============ -->
  <Divider n="01" id="gao" title="Built with the<br/>GAO labs." sub="Partnerships with Google, Anthropic and OpenAI. We test the models you actually run." />

  <section class="sec sec--dark" aria-labelledby="gao-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="kicker">Our GAO partners</p>
        <h2 class="display h2" id="gao-title">We work inside the ecosystems you build on.</h2>
      </header>
      <div class="cols3 gao">
        {partners.map((p, i) => (
          <article class="gao__card reveal" style={`transition-delay:${i * 90}ms`}>
            <div class="gao__top">
              <Logo name={p.logo} size={36} />
              <span class="mono gao__model">{p.model}</span>
            </div>
            <h3 class="display h3">{p.name}</h3>
            <div class="bar"></div>
            <p class="gao__body">{p.body}</p>
          </article>
        ))}
      </div>
      <p class="band reveal"><strong>Why GAO matters:</strong> we test the models you actually run, with insight into how they are built and where they fail. Model agnostic across Gemini, Claude, GPT and open weight models.</p>
    </div>
  </section>

  <!-- ============ OFFER ============ -->
  <section class="sec sec--light" id="offer" aria-labelledby="offer-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="kicker">Our offer</p>
        <h2 class="display h2" id="offer-title">One integrated path to trustworthy AI.</h2>
      </header>
      <ol class="offer">
        {offer.map((o, i) => (
          <li class={`offer__step offer__step--${i} reveal`} style={`transition-delay:${i * 80}ms`}>
            <span class="mono offer__n">{o.n}</span>
            <span class="display offer__t">{o.title}</span>
            <span class="offer__b">{o.body}</span>
          </li>
        ))}
      </ol>
      <div class="cols2 brings">
        {brings.map((b) => (
          <div class="reveal">
            <p class="kicker">{b.who}</p>
            <p class="brings__b">{b.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 02 ASSESS ============ -->
  <Divider n="02" id="assess" title="Know where<br/>you stand." sub="Current state assessment, powered by the Claude Fable rapid eval." />

  <section class="sec sec--light" aria-labelledby="csa-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="kicker">Current state assessment</p>
        <h2 class="display h2" id="csa-title">Five dimensions. One honest baseline.</h2>
      </header>
      <div class="csa">
        <figure class="radar reveal">
          <svg viewBox="-95 0 510 330" role="img" aria-label="Illustrative maturity radar: current versus target across five dimensions">
            {[0.2, 0.4, 0.6, 0.8, 1].map((f) => <polygon points={ring(f)} fill="none" stroke="var(--rule)" stroke-width="1" />)}
            {angles.map((a) => <line x1={C} y1={C} x2={pt(a, R).split(',')[0]} y2={pt(a, R).split(',')[1]} stroke="var(--rule)" />)}
            <polygon points={ring(0.7)} fill="none" stroke="var(--ink)" stroke-width="1.5" stroke-dasharray="5 4" />
            <polygon points={current} fill="var(--purple)" fill-opacity="0.18" stroke="var(--purple)" stroke-width="2.5" stroke-linejoin="round" />
            {angles.map((a, i) => { const [x, y] = pt(a, dimensions[i].current * R).split(','); return <circle cx={x} cy={y} r="4" fill="var(--purple)" />; })}
            {labelPos.map((l, i) => (
              <text x={l.x} y={l.y + (i === 0 ? -4 : i === 2 || i === 3 ? 14 : 5)} text-anchor={l.anchor} class="radar__l">{dimensions[i].n} {dimensions[i].short}</text>
            ))}
          </svg>
          <figcaption class="mono radar__cap"><span class="sw sw--cur"></span>Current <span class="sw sw--tgt"></span>Target <span class="muted">/ Illustrative</span></figcaption>
        </figure>
        <div>
          <ol class="dims">
            {dimensions.map((d, i) => (
              <li class="reveal" style={`transition-delay:${i * 60}ms`}>
                <span class="mono dims__n">{d.n}</span>
                <span><strong>{d.title}</strong><span class="muted dims__b">{d.body}</span></span>
              </li>
            ))}
          </ol>
          <div class="outputs reveal">
            <p class="kicker">Outputs</p>
            <ul>{outputs.map((o, i) => <li>{i > 0 && <Chevron class="outputs__chev" />}{o}</li>)}</ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Rapid eval spotlight -->
  <section class="sec sec--dark fable" aria-labelledby="fable-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="kicker">Spotlight / Claude Fable rapid eval</p>
        <h2 class="display h2" id="fable-title">Evidence in weeks, not quarters.</h2>
        <p class="lede">
          Anthropic’s Claude Fable is our evaluation engine. It writes realistic and adversarial tests from your own
          policies, runs them against your models and agents, and grades every response. Faculty scientists calibrate
          the grader and verify each high severity finding.
        </p>
      </header>

      <ol class="timeline">
        {rapidEval.map((s, i) => (
          <li class={`timeline__s reveal ${i === rapidEval.length - 1 ? 'is-last' : ''}`} style={`transition-delay:${i * 90}ms`}>
            <span class="mono timeline__w">{s.when}</span>
            <span class="timeline__dot"></span>
            <span class="display timeline__t">{s.title}</span>
            <span class="timeline__b">{s.body}</span>
          </li>
        ))}
      </ol>

      <div class="loop">
        <div class="loop__hub reveal">
          <Chevron class="loop__chev" />
          <p class="display">Claude<br />Fable</p>
          <p class="mono loop__cap">How it works</p>
        </div>
        <ol class="loop__steps">
          {loop.map((s, i) => (
            <li class="reveal" style={`transition-delay:${i * 60}ms`}>
              <span class="mono loop__n">{s.n}</span>
              <strong>{s.title}</strong>
              <span class="loop__b">{s.body}</span>
            </li>
          ))}
        </ol>
      </div>

      <ul class="facts mono reveal">
        <li>Thousands of scenarios per use case</li>
        <li>Any GAO or open weight model</li>
        <li>Human verified, audit ready evidence</li>
      </ul>
    </div>
  </section>

  <!-- Sample output -->
  <section class="sec sec--mist" aria-labelledby="sample-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="kicker">Sample output</p>
        <h2 class="display h2" id="sample-title">A clear picture and a ranked agenda.</h2>
      </header>
      <div class="sample">
        <figure class="heat reveal" aria-label="Illustrative maturity heatmap">
          <div class="heat__grid">
            <span></span>
            {maturityLevels.map((l) => <span class="mono heat__col">{l}</span>)}
            {heatmap.map((r) => (
              <>
                <span class="heat__row">{r.label}</span>
                {maturityLevels.map((_, c) => (
                  <span class={`heat__cell ${c === 3 ? 'is-tgt' : ''}`} style={c < r.score ? `background:var(--purple);opacity:${Math.min(1, 0.4 + 0.2 * (c + 1))}` : ''}></span>
                ))}
              </>
            ))}
          </div>
          <figcaption class="mono heat__cap"><span class="heat__tgt"></span>Target: between Defined and Managed <span class="muted">/ Illustrative</span></figcaption>
        </figure>
        <div class="reveal">
          <p class="kicker">Top findings (illustrative)</p>
          <ol class="find">
            {findings.map((f, i) => <li><span class="mono">0{i + 1}</span><span>{f}</span></li>)}
          </ol>
          <p class="muted find__note">Each finding maps to a governance action.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 03 GOVERN ============ -->
  <Divider n="03" id="govern" title="From findings<br/>to operations." sub="Turning the assessment into a governance design that runs." />

  <section class="sec sec--light" aria-labelledby="fta-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="kicker">Governance design</p>
        <h2 class="display h2" id="fta-title">Every finding becomes an owned, operational action.</h2>
      </header>
      <div class="fta reveal" role="table" aria-label="Assessment findings mapped to governance actions and owners">
        <div class="fta__row fta__head" role="row">
          <span class="kicker" role="columnheader">Assessment finding</span>
          <span role="columnheader"><span class="sr">Leads to</span></span>
          <span class="kicker" role="columnheader">Governance design action</span>
          <span class="kicker" role="columnheader">Owner</span>
        </div>
        {findingToAction.map((r) => (
          <div class="fta__row" role="row">
            <span role="cell" class="fta__f">{r.finding}</span>
            <span role="cell" aria-hidden="true"><Chevron class="fta__chev" /></span>
            <span role="cell" class="fta__a">{r.action}</span>
            <span role="cell" class="mono fta__o">{r.owner}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--mist" aria-labelledby="life-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="kicker">Operating model</p>
        <h2 class="display h2" id="life-title">Governance built into the AI lifecycle.</h2>
      </header>
      <ol class="life reveal">
        {lifecycle.map((s) => (
          <li class={s.key ? 'is-key' : ''}>
            <span class="display life__s">{s.stage}</span>
            <span class="life__g">{s.gate}</span>
          </li>
        ))}
      </ol>
      <div class="cols3 operate">
        {operate.map((o, i) => (
          <div class="reveal" style={`transition-delay:${i * 80}ms`}>
            <p class="kicker">{o.k}</p>
            <p>{o.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 04 IMPLEMENT ============ -->
  <Divider n="04" id="implement" title="Make it real." sub={`Implementing ${PRC}, governance and continuous assurance.`} />

  <section class="sec sec--light" aria-labelledby="prc-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="kicker">Implementation / {PRC} = {PRC_FULL}</p>
        <h2 class="display h2" id="prc-title">{PRC}: the backbone that makes governance enforceable.</h2>
      </header>
      <div class="prc">
        {prc.map((p, i) => (
          <article class={`prc__col reveal ${i === 2 ? 'is-key' : ''}`} style={`transition-delay:${i * 90}ms`}>
            <span class="display prc__l">{p.letter}</span>
            <h3 class="display h3">{p.title}</h3>
            <ul>{p.items.map((it) => <li>{it}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="prc__flow reveal">
        <strong>Policy</strong> sets the rules <Chevron class="inline-chev" /> <strong>Risk</strong> sizes the exposure <Chevron class="inline-chev" /> <strong>Controls</strong> enforce and evidence
      </p>
      <div class="sec-security reveal">
        <p class="kicker">Security by design</p>
        <ul>{security.map((s) => <li>{s}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="sec sec--dark" id="assure" aria-labelledby="rt-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="kicker">Red teaming and monitoring</p>
        <h2 class="display h2" id="rt-title">Attack it first, then keep watching.</h2>
        <p class="lede">Faculty led red teams pair automated attack generation with expert adversaries who know how frontier models fail, then monitor in production.</p>
      </header>
      <div class="rt">
        <figure class="rt__fig reveal">
          <svg viewBox="0 0 600 340" role="img" aria-label={`Attack surface: ${attacks.join(', ')} aimed at your AI system`}>
            <defs>
              <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" fill="var(--purple)" />
              </marker>
            </defs>
            {atk.map((a) => {
              // From just outside the label box to just outside the system box.
              const dx = 300 - a.x, dy = 170 - a.y, len = Math.hypot(dx, dy);
              const ux = dx / len, uy = dy / len;
              const clear = (hw: number, hh: number) => Math.min(hw / Math.abs(ux || 1e-6), hh / Math.abs(uy || 1e-6));
              const s0 = clear(a.t.length * 4.6 + 10, 20), s1 = len - clear(97, 52);
              return <line x1={a.x + ux * s0} y1={a.y + uy * s0} x2={a.x + ux * s1} y2={a.y + uy * s1} stroke="var(--purple)" stroke-width="2" marker-end="url(#ah)" />;
            })}
            <rect x="215" y="128" width="170" height="84" fill="#fff" />
            <text x="300" y="166" text-anchor="middle" class="rt__sys">Your AI system</text>
            <text x="300" y="190" text-anchor="middle" class="rt__sub">model + tools + data</text>
            {atk.map((a) => <text x={a.x} y={a.y + 5} text-anchor="middle" class="rt__atk">{a.t}</text>)}
          </svg>
          <ul class="rt__list">{attacks.map((a) => <li><Chevron class="inline-chev" /> {a}</li>)}</ul>
        </figure>
        <ol class="cad reveal">
          {cadence.map((c) => (
            <li><strong class="display">{c.when}</strong><span>{c.body}</span></li>
          ))}
        </ol>
      </div>
      <p class="muted rt__foot mono">Model agnostic across GAO (Gemini, Claude, GPT) and open weight models.</p>
    </div>
  </section>

  <section class="sec sec--light" aria-labelledby="road-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="kicker">Implementation roadmap</p>
        <h2 class="display h2" id="road-title">Six months from assessment to steady state.</h2>
      </header>
      <div class="road reveal" role="img" aria-label="Indicative six month roadmap">
        <div class="road__months">
          <span></span>
          <div class="road__axis">{[1, 2, 3, 4, 5, 6].map((m) => <span class="mono"><span class="road__mw">Month </span>{m}</span>)}</div>
        </div>
        {roadmap.map((r) => (
          <div class="road__row">
            <span class="road__l">{r.label}</span>
            <div class="road__track">
              <span class={`road__bar road__bar--${r.tone}`} style={`left:${(r.start / 6) * 100}%;width:${((r.end - r.start) / 6) * 100}%`}></span>
              {r.note && <span class="mono road__note" style={`left:calc(${(r.end / 6) * 100}% + 10px)`}>{r.note}</span>}
            </div>
          </div>
        ))}
      </div>
      <p class="muted road__cap mono">Indicative timeline, calibrated to scope in week 1.</p>
    </div>
  </section>

  <!-- ============ 05 NEXT STEPS ============ -->
  <Divider n="05" title="Next steps." sub="Five actions to start in the next four weeks." />

  <section class="sec sec--light" aria-labelledby="next-title">
    <div class="wrap">
      <header class="sec-head reveal">
        <p class="kicker">Next steps</p>
        <h2 class="display h2" id="next-title">Five actions, four weeks.</h2>
      </header>
      <div class="weeks reveal">
        {weeks.map((w) => (
          <div class="weeks__col">
            <p class="mono weeks__h"><span class="weeks__dot"></span>Week {w}</p>
            {nextSteps.filter((s) => s.week === w).map((s) => (
              <div class={`weeks__card ${s.n === '05' ? 'is-key' : ''} ${s.n === '—' ? 'is-flight' : ''}`}>
                {s.n !== '—' && <span class="mono weeks__n">{s.n}</span>}
                <strong>{s.title}</strong>
                <span class="weeks__o">{s.owner}</span>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CLOSE ============ -->
  <section class="close grid-bg" id="start" aria-labelledby="close-title">
    <Chevron class="hero__chev close__chev" />
    <div class="wrap close__in">
      <div class="reveal">
        <p class="kicker">Where to start</p>
        <h2 class="display h1" id="close-title">AI you can trust,<br />and prove it.</h2>
        <p class="lede close__lede">
          Thirty minutes with the executive accountable for AI risk or deployment. We agree what a first evaluation
          should prove. One way to begin: a <span class="close__em">two week Claude Fable rapid evaluation</span>.
        </p>
      </div>
      <dl class="contacts reveal">
        <div><dt class="mono">Accenture</dt><dd>[Name, title, email]</dd></div>
        <div><dt class="mono">Faculty</dt><dd>[Name, title, email]</dd></div>
      </dl>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; min-height: 100svh; display: flex; overflow: hidden; }
  .hero__in { position: relative; display: flex; flex-direction: column; justify-content: space-between; padding-top: clamp(140px, 22vh, 220px); padding-bottom: 40px; gap: 64px; }
  .hero__copy { display: grid; gap: 28px; max-width: 980px; }
  .hero__lede { color: var(--silver); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }
  :global(.hero__chev) { position: absolute; right: clamp(-80px, 5vw, 110px); bottom: 14vh; height: clamp(300px, 56vh, 620px); width: auto; }
  @media (max-width: 900px) { :global(.hero__chev) { opacity: 0.32; right: -60px; } }
  .hero__gao { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 20px 40px; border-top: 1px solid var(--grid); padding-top: 28px; }
  .hero__with { grid-column: 1 / -1; font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--silver); }
  .hero__logos { display: flex; flex-wrap: wrap; align-items: center; gap: 20px clamp(32px, 5vw, 72px); }
  .hero__p { display: inline-flex; align-items: center; gap: 16px; color: #fff; font-size: clamp(26px, 2.8vw, 38px); line-height: 1; }
  .hero__hist { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--silver); padding-bottom: 6px; border-bottom: 1.5px solid var(--purple); white-space: nowrap; transition: color 0.2s; }
  .hero__hist:hover { color: #fff; }
  .hero__hist :global(svg) { width: 7px; height: 11px; }
  @media (max-width: 760px) { .hero__gao { grid-template-columns: 1fr; } .hero__p :global(svg) { width: 32px; height: 32px; } .hero__hist { justify-self: start; } }

  /* ---------- shared layout ---------- */
  .cols3 { display: grid; gap: clamp(32px, 4vw, 56px); grid-template-columns: repeat(3, 1fr); }
  .cols2 { display: grid; gap: clamp(32px, 4vw, 56px); grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 860px) { .cols3, .cols2 { grid-template-columns: 1fr; } }

  .moment { display: grid; gap: 16px; align-content: start; }
  .moment__n { font-size: 13px; color: var(--grey); letter-spacing: 0.2em; }

  /* ---------- GAO ---------- */
  .gao__card { display: grid; gap: 18px; align-content: start; padding: 32px; border: 1px solid var(--grid); background: rgba(9, 9, 11, 0.6); transition: border-color 0.3s var(--ease); }
  .gao__card:hover { border-color: var(--purple); }
  .gao__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  .gao__model { font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--silver); border: 1px solid var(--grid); padding: 4px 10px; }
