---
// Small UI arrow for links, buttons and lists: a thin stroked chevron in the
// current text colour. Deliberately not the Accenture ">" mark, which appears
// only inside the Accenture x Faculty co-brand logos.
interface Props { class?: string; color?: string; label?: string }
const { class: cls, color = 'currentColor', label } = Astro.props;
---
<svg class={cls} viewBox="0 0 62 100" fill="none" stroke={color} stroke-width="14" stroke-linecap="round" stroke-linejoin="round" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <path d="M10 12 L52 50 L10 88" />
</svg>
